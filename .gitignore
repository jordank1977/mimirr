# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
/node_modules

# Testing
/coverage

# Next.js Build Artifacts
/.next/
/out/

# Debug Logs
npm-debug.log*

# Misc & Keys
.DS_Store
*.pem
*.key
.eslintcache

# Secrets (Always Ignore)
.env*
!.env.example

# TypeScript
*.tsbuildinfo

# Database (Local SQLite — local-only, never commit)
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.db

# Application Logs
/logs/
/config/logs/

# -------------------------------------------------------------------
# AI / Agent Context
# -------------------------------------------------------------------
# .agents/ IS tracked and pushed (rules + workflows are part of the
# project). One workflow exception stays local-only — see
# .git/info/exclude rather than listing it here.
.agents-dev/
.agents/workflows/